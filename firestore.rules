rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 원장님 Google 계정만 읽고 쓸 수 있음. 선생님을 추가하려면 목록에 이메일을 더한다.
    function allowed() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['ilmvm66@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
    // 학부모님께 보내는 분석지 링크: 링크(긴 무작위 주소)를 아는 사람만 한 건씩 열람. 목록 보기는 막음.
    match /shared/{id} {
      allow get: if true;
    }
  }
}
